# EcoInvest Backend Configuration

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# gRPC Configuration (Carbon Intelligence Microservice)
GRPC_HOST=localhost
GRPC_PORT=50051

# LLM Configuration
# LLM_MODE: 'gemini' or 'ollama' (default: 'gemini')
LLM_MODE=gemini

# Google Gemini API (for AI Chat) - Required when LLM_MODE=gemini
GOOGLE_API_KEY=your_gemini_api_key_here

# Ollama Configuration - Required when LLM_MODE=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Tavily API (for web search in company analysis)
TAVILY_API_KEY=your_tavily_api_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

NEWS_API_KEY=your_actual_key_here