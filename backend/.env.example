# EcoInvest Backend Configuration

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration (for local Flask app connecting to Docker PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carbon_intel
DB_USER=carbon
DB_PASSWORD=carbonpw

# gRPC Configuration (Carbon Intelligence Microservice)
GRPC_HOST=localhost
GRPC_PORT=50051

# Pathway Output Directory (for local Flask app)
PATHWAY_OUTPUT_DIR=./carbon-intelligence/server/output

# Google Gemini API (for AI Chat)
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily API (for web search in company analysis)
TAVILY_API_KEY=your_tavily_api_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# NewsAPI Key
NEWS_API_KEY=your_newsapi_key_here
